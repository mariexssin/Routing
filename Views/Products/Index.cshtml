@model IEnumerable<ProductsWithRouting.Models.Product>

@{
    ViewData["Title"] = "Products List";
}

<h1>Products</h1>

<form method="get" action="/products/index" class="mb-3">
    <input type="number" name="filterId" placeholder="Filter by ID..." value="@Context.Request.Query["filterId"]" />
    <input type="text" name="filtername" placeholder="Filter by name..." value="@Context.Request.Query["filtername"]" />
    <button type="submit">Filter</button>
    <a href="/products/index">Reset</a>
</form>

<p>
    <a href="/products/create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Id)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Description)
            </th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Id)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            <td>
                <!-- Пункт 2: Перехід на View, Edit, Delete -->
                <a href="/products/edit/@item.Id">Edit</a> | 
                <a href="/products/@item.Id">View</a> | 
                <a href="/products/delete/@item.Id" onclick="return confirm('Are you sure you want to delete this product?');">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>